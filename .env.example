# Copy to .env and enter explicitly verified values for YOUR selected model.
# Defaults deliberately prevent paid calls. Never commit .env.
CAREERPILOT_ENABLE_PAID_CALLS=false
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_PRICING_VERIFIED=false
MODEL_INPUT_USD_PER_MILLION=
MODEL_OUTPUT_USD_PER_MILLION=
MODEL_PRICING_SOURCE=
MODEL_PRICING_VERIFIED_ON=
MONTHLY_BUDGET_USD=5
PER_RUN_BUDGET_USD=0.10
# Explicit grants for this fictional local exercise only; both default to denied.
MOCK_CONSENT_ACCURACY=false
MOCK_CONSENT_SUBMIT=false
MAX_INPUT_TOKENS=12000
MAX_OUTPUT_TOKENS=2000
MAX_ACTIONS=40
MAX_RUN_MS=120000
HEADLESS=true
CAREERPILOT_STATE_DIR=.careerpilot
