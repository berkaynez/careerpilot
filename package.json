{
  "name": "careerpilot",
  "version": "0.1.0-beta.1",
  "private": true,
  "type": "module",
  "description": "Local-first hybrid job application hub with evidence-based analysis and supervised form assistance",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --import tsx src/hub/cli.ts --port 3211 --enable-search --enable-model",
    "start:offline": "node --import tsx src/hub/cli.ts --port 3211",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "demo": "tsx src/mocks/demo.ts",
    "browser:install": "playwright install chromium",
    "agent": "node --env-file=.env --import tsx src/cli.ts",
    "prepare": "node --import tsx src/preparation/cli.ts",
    "lever:inspect": "node --import tsx src/lever/cli.ts",
    "lever:preview": "node --import tsx src/lever/preview-cli.ts",
    "lever:upload-draft": "node --import tsx src/lever/upload-cli.ts",
    "lever:review": "node --import tsx src/lever/upload-cli.ts --keep-open",
    "job": "node --import tsx src/jobs/cli.ts",
    "assist": "node --import tsx src/applications/cli.ts",
    "hub": "node --import tsx src/hub/cli.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "playwright": "^1.64.1",
    "zod": "^4.6.7"
  },
  "license": "UNLICENSED"
}
