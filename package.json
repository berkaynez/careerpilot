{
  "name": "careerpilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first, AI-led job application agent foundations",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "demo": "tsx src/mocks/demo.ts",
    "browser:install": "playwright install chromium",
    "agent": "node --env-file=.env --import tsx src/cli.ts",
    "prepare": "node --import tsx src/preparation/cli.ts",
    "lever:inspect": "node --import tsx src/lever/cli.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "playwright": "^1.64.1",
    "zod": "^4.6.7"
  }
}
